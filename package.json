{
  "name": "talos-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "helper:build": "node scripts/build-helper.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "build:native-test": "vite build --config vite.native-test.config.ts",
    "production:check": "node scripts/check-production-exclusion.ts",
    "advisories:check": "node scripts/advisory-baseline.ts",
    "test:native": "node scripts/test-native.ts",
    "lint": "oxlint --type-aware --type-check --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm test:run && pnpm build",
    "icons:generate": "node scripts/icons.ts --write",
    "icons:check": "node scripts/icons.ts",
    "contracts:generate": "node scripts/contracts.ts --write",
    "contracts:check": "node scripts/contracts.ts --check",
    "release:check": "node scripts/release-metadata.ts",
    "release:check-linux": "node scripts/appimage-resources.ts",
    "release:assets": "node scripts/release-assets.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "antd": "6.6.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "@wdio/cli": "9.31.9",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.9",
    "@wdio/mocha-framework": "9.31.9",
    "@wdio/tauri-plugin": "1.5.0",
    "@wdio/tauri-service": "1.5.0",
    "@wdio/types": "9.31.2",
    "jsdom": "30.1.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.10.1"
}
