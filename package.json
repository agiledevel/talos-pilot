{
  "name": "talos-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "toolchain:bootstrap": "node scripts/dev-toolchain.ts",
    "helper:build": "node scripts/build-helper.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "build:native-test": "vite build --config vite.native-test.config.ts",
    "production:check": "node scripts/check-production-exclusion.ts",
    "advisories:check": "node scripts/advisory-baseline.ts",
    "audit:go": "node scripts/go-vulnerability-scan.ts",
    "audit:npm": "node scripts/npm-advisory-scan.ts",
    "talos:fixture": "node scripts/talos-fixture.ts",
    "kubernetes:fixture": "node scripts/kubernetes-fixture.ts",
    "inventory:generate": "node scripts/dependency-inventory.ts",
    "inventory:check": "node scripts/dependency-inventory.ts --check",
    "notices:generate": "node scripts/notices.ts generate",
    "notices:check": "node scripts/notices.ts check",
    "notices:check-packaged": "node scripts/notices.ts check-packaged",
    "test:native": "node scripts/test-native.ts",
    "lint": "oxlint --type-aware --type-check --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "lint:svelte": "svelte-check --tsgo --tsconfig ./tsconfig.svelte.json --fail-on-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:preview": "playwright test --config=playwright.preview.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm lint:svelte && pnpm test:run && pnpm build",
    "check:ci": "pnpm format:check && pnpm lint && pnpm lint:svelte && pnpm test:coverage && pnpm build",
    "icons:generate": "node scripts/icons.ts --write",
    "icons:check": "node scripts/icons.ts",
    "contracts:generate": "node scripts/contracts.ts --write",
    "contracts:check": "node scripts/contracts.ts --check",
    "release:check": "node scripts/release-metadata.ts",
    "release:check-linux": "node scripts/appimage-resources.ts",
    "release:assets": "node scripts/release-assets.ts",
    "release:verify": "node scripts/verify-artifacts.ts",
    "payload:check": "node scripts/check-payload.ts"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@skeletonlabs/skeleton": "5.0.1",
    "@skeletonlabs/skeleton-svelte": "5.0.1",
    "@tanstack/svelte-query": "6.3.1",
    "@tauri-apps/api": "2.12.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "bits-ui": "2.19.5",
    "monaco-editor": "0.57.0",
    "svelte": "5.57.2",
    "uplot": "1.6.32",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.7",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.3",
    "@wdio/cli": "9.31.9",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.9",
    "@wdio/mocha-framework": "9.31.9",
    "@wdio/tauri-plugin": "1.5.0",
    "@wdio/tauri-service": "1.5.0",
    "@wdio/types": "9.31.2",
    "jsdom": "30.1.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
